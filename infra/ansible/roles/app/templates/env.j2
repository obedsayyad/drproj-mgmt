# Managed by Ansible (app role). Mode 0600. Names follow drproj-app deploy/compose/app/.env.example.
RELIEF_IMAGE={{ app_image }}
SUPABASE_APP_URL={{ app_supabase_url }}
DEMO_MODE={{ app_demo_mode | bool | lower }}
APP_DB_POOL_MAX={{ app_db_pool_max }}
# One CPU worker per vCPU (the library cap is 4): with a single worker a 2 vCPU host can never exceed ~58% CPU under the demo workload and the
# 60% scale-out threshold is unreachable. Cloud VMs have 1 vCPU, so they keep one worker.
DEMO_MAX_CPU_WORKERS={{ [ansible_facts['processor_vcpus'] | default(1), 4] | min }}
INSTANCE_ID={{ app_instance_id }}
INSTANCE_ROLE={{ app_instance_role }}
INSTANCE_PROVIDER={{ app_instance_provider }}
INSTANCE_REGION={{ app_instance_region }}
INSTANCE_LABEL={{ app_instance_label }}
APP_VERSION={{ app_version }}
RATE_LIMIT_EXEMPT_IPS={{ inputs.rate_limit_exempt_ips | join(',') }}
TRUSTED_PROXY_IPS={{ inputs.hosts.load_balancer.public_ip }}
APP_PORT={{ inputs.ports.app_https }}
APP_METRICS_PORT={{ inputs.ports.app_metrics }}
NODE_EXPORTER_PORT={{ inputs.ports.node_exporter }}
NODE_EXPORTER_TAG={{ inputs.versions.node_exporter }}
