# Managed by Ansible (mgmt role). Mode 0600. Never commit.
OPS_HOST={{ inputs.ingress.operations }}
GRAFANA_HOST={{ inputs.ingress.grafana }}
ST2_HOST={{ inputs.ingress.stackstorm }}
STATS_HOST={{ inputs.ingress.haproxy_stats }}
ACME_EMAIL={{ mgmt_acme_email }}
ACME_CA={{ mgmt_acme_ca }}
SUPABASE_OPS_URL={{ mgmt_supabase_ops_url }}
SUPABASE_APP_URL={{ mgmt_supabase_app_url }}
DR_AUTOMATION_URL={{ mgmt_dr_automation_url }}
OPS_OPERATOR_PASSWORD={{ mgmt_operator_password }}
OPS_BASIC_AUTH_HASH='{{ mgmt_ops_basic_auth_hash }}'
{% if mgmt_st2_api_key | length > 0 %}
ST2_API_URL=http://st2api:9101
ST2_API_KEY={{ mgmt_st2_api_key }}
{% endif %}
PROMETHEUS_EXPECTED_JOBS={{ mgmt_expected_jobs }}
MGMT_SECRETS_DIR={{ mgmt_secrets_dir }}
BACKEND_CA_BUNDLE_HOST={{ mgmt_ca_bundle }}
SUPABASE_CA_HOST={{ mgmt_supabase_ca }}
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD={{ mgmt_mongo_password }}
RABBITMQ_USER=drproj
RABBITMQ_PASSWORD={{ mgmt_rabbit_password }}
RESTORE_TEST_PG_PASSWORD={{ mgmt_restore_pg_password }}
NODE_EXPORTER_BASIC_AUTH_PASSWORD={{ mgmt_scrape_password }}
HAPROXY_STATS_UPSTREAM={{ mgmt_lb_ip }}:8404
HAPROXY_STATS_CA=/etc/caddy/ca-bundle.crt
HAPROXY_ADMIN_ADDR={{ mgmt_lb_ip }}:9999
OPS_IMAGE={{ mgmt_ops_image }}
ST2_RUNNER_IMAGE={{ mgmt_runner_image }}
HAPROXY_STATE_HOST={{ mgmt_haproxy_state_dir }}
