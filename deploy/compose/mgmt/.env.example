# Names only; supply real values out-of-band (never commit). File mode 0600 inside a 0700 directory.
# Hostnames
OPS_HOST=
GRAFANA_HOST=
ST2_HOST=
STATS_HOST=
# Required for the production Caddyfile (ACME contact). ACME_CA defaults to Let's Encrypt STAGING.
ACME_EMAIL=
ACME_CA=
HAPROXY_STATS_UPSTREAM=
# Ops API
SUPABASE_OPS_URL=
OPS_DB_POOL_MAX=
# Shared operator password (>= 12 chars), enforced by Caddy and by the API.
OPS_OPERATOR_PASSWORD=
# DERIVED from OPS_OPERATOR_PASSWORD and must match it. Single-quote the value ('$2a$...') so Compose
# does not interpolate `$`:  docker run --rm caddy:<tag> caddy hash-password --plaintext "$OPS_OPERATOR_PASSWORD"
OPS_BASIC_AUTH_HASH=
ST2_API_URL=
ST2_API_KEY=
HAPROXY_STATS_URL=
# Scrape jobs that must all be fresh for the overview's Prometheus integration (default prometheus,ops,alertmanager; add relief in P5)
PROMETHEUS_EXPECTED_JOBS=
# Directory holding the secret files listed in secrets/README.md (default ./secrets)
MGMT_SECRETS_DIR=
# StackStorm backing stores (must match secrets/st2.user.conf)
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Restore validation database (profile restore-test only)
RESTORE_TEST_PG_PASSWORD=
# Optional image tag overrides (defaults are in compose.yaml / docs/config deployment inputs)
OPS_IMAGE=
ST2_RUNNER_IMAGE=
