# Names only; supply real values out-of-band (never commit). Mode 0600 on the management VM.
SUPABASE_OPS_URL=
OPS_PORT=
# Integer 1..5 (default 3); any other value makes the API refuse to start.
OPS_DB_POOL_MAX=
# Required (min 12 chars) unless OPS_TRUST_PROXY_AUTH=true; the API refuses to start otherwise.
OPS_OPERATOR_PASSWORD=
# Set true only to rely on Caddy basic auth alone (no password check in the API itself).
OPS_TRUST_PROXY_AUTH=
ST2_API_URL=
ST2_API_KEY=
PROMETHEUS_URL=
HAPROXY_STATS_URL=
# Local real-Postgres integration tests only (not Supabase)
TEST_DATABASE_URL=
